         <xmpMM:InstanceID>uuid:0b73ce0f-4bff-466e-814b-c1a85b2236c0</xmpMM:InstanceID>
         <xmpMM:OriginalDocumentID>adobe:docid:indd:351320ea-b18b-11dd-bb45-d59efdcd6868</xmpMM:OriginalDocumentID>
         <xmpMM:DocumentID>xmp.id:ad6554e0-11c7-4d48-99c1-5f3710fb9cab</xmpMM:DocumentID>
         <xmpMM:RenditionClass>proof:pdf</xmpMM:RenditionClass>
         <xmpMM:DerivedFrom rdf:parseType="Resource">
            <stRef:instanceID>xmp.iid:26888a1e-c46d-42bc-adf9-1b32450056fc</stRef:instanceID>
            <stRef:documentID>xmp.did:feaea00b-2ed8-ea44-9bf4-9da74b1186ff</stRef:documentID>
            <stRef:originalDocumentID>adobe:docid:indd:351320ea-b18b-11dd-bb45-d59efdcd6868</stRef:originalDocumentID>
            <stRef:renditionClass>default</stRef:renditionClass>
         </xmpMM:DerivedFrom>
