@startuml
skinparam backgroundColor #f5f5f5
skinparam defaultFontName "Helvetica Neue", Arial, sans-serif
skinparam roundCorner 8
skinparam shadowing false

skinparam activity {
  BackgroundColor #ffffff
  BorderColor #0b3c5d
  BorderThickness 1.5
  FontColor #1d2731
  DiamondBackgroundColor #e8eff5
  DiamondBorderColor #0b3c5d
  FontSize 13
}

skinparam arrow {
  Color #0b3c5d
  FontColor #333333
  FontSize 11
}

|#f0f4f8|Customer|
start
:Browse menu & select dishes;
:Submit order with delivery address;

|#e8eff5|Platform Core|
:Validate cart items & calculate total;
:Authorize payment via Gateway;
if (Payment Authorized?) then (yes)
  :Create OrderRecord in "PLACED" state;
else (no)
  :Display payment decline error;
  detach
endif

|#ffffff|Restaurant Partner|
:Receive new order alert;
if (Accept Order?) then (yes)
  :Accept order ticket;
  :Kitchen starts cooking meal;
  :Mark order "READY FOR PICKUP";
  detach
else (no)
  |Platform Core|
  :Issue instant refund to Customer;
  :Notify Customer of merchant decline;
  detach
endif

@enduml
